# Files and directories excluded from the distributed plugin build
# (e.g. `wp dist-archive`). Runtime files such as prompts/meta-generation.md
# are intentionally NOT listed here — they ship with the plugin.

# Version control and repo metadata
/.git
/.github
/.gitignore
/.gitattributes
/.distignore
/.editorconfig

# Tooling / dependency manifests
/composer.json
/composer.lock
/package.json
/package-lock.json
/phpcs.xml
/phpcs.xml.dist
/phpunit.xml
/phpunit.xml.dist

# Dependencies and dev-only directories
/vendor
/node_modules
/tests
/bin

# OS cruft
.DS_Store
Thumbs.db
