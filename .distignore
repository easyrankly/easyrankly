# Files and directories excluded from the distributed plugin build
# (e.g. `wp dist-archive`). Runtime files such as prompts/meta-generation.md
# are intentionally NOT listed here, because they ship with the plugin.

# Version control and repo metadata
/.git
/.github
/.gitignore
/.gitattributes
/.distignore
/.editorconfig

# Tooling / dependency manifests
/composer.json
/composer.lock
/package.json
/package-lock.json
/phpcs.xml
/phpcs.xml.dist
/phpunit.xml
/phpunit.xml.dist
/eslint.config.mjs
/stylelint.config.mjs

# Dependencies and dev-only directories
/vendor
/node_modules
/tests
/docs
/bin
/coverage
/build
/dist

# Local, generated, and sensitive files
/.env
/.env.*
/pro-evidence*.json
*.log
*.cache
*.tmp
/.eslintcache
/.phpcs-cache
/.phpunit.cache
/.phpunit.result.cache
/.stylelintcache
/*.zip

# Editors / IDEs
/.idea
/.vscode
*.sublime-project
*.sublime-workspace
*.swp

# OS cruft
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
