<?xml version="1.0"?>
<ruleset name="EasyRankly">
	<description>Coding standards for the EasyRankly plugin.</description>

	<!-- Scan the whole plugin, starting from its root. -->
	<file>.</file>

	<!-- Only PHP files are checked. -->
	<arg name="extensions" value="php"/>

	<!-- Show sniff codes and a progress bar, use colours, run in parallel. -->
	<arg value="sp"/>
	<arg name="colors"/>
	<arg name="parallel" value="8"/>

	<!-- Never scan generated or third-party directories. -->
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/assets/*</exclude-pattern>

	<!-- WordPress plugin coding standards (rules + best practices + docs). -->
	<rule ref="WordPress"/>
	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>

	<!-- Target PHP version(s): 8.0 and up, matching "Requires PHP". -->
	<config name="testVersion" value="8.0-"/>
	<rule ref="PHPCompatibilityWP"/>

	<!-- Oldest WordPress release the plugin supports (matches "Requires at least"). -->
	<config name="minimum_wp_version" value="6.2"/>

	<!-- All global symbols must carry one of the plugin's prefixes. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="erankly"/>
				<element value="easyrankly"/>
				<element value="ERANKLY"/>
			</property>
		</properties>
	</rule>

	<!-- All translatable strings must use the plugin's text domain. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="easyrankly"/>
			</property>
		</properties>
	</rule>
</ruleset>
