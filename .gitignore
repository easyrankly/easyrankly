# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Editors / IDEs
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp

# Logs and temp files
*.log
*.cache
*.tmp
/.eslintcache
/.phpcs-cache
/.phpunit.cache/
/.phpunit.result.cache
/.stylelintcache
/coverage/
/build/
/dist/
/*.zip

# Dependencies and build artifacts (never commit these)
/vendor/
/node_modules/

# Local environment
.env
.env.*
!.env.example

# Licensed release evidence must remain outside version control
/pro-evidence*.json

# Local-only tooling. Tracked release tooling and documentation are excluded
# from the WordPress.org archive by .distignore.
/package.json
/package-lock.json
/phpcs.xml
/eslint.config.mjs
/stylelint.config.mjs
/.editorconfig
