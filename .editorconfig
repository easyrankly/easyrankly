# EditorConfig: https://editorconfig.org
# Keeps every editor aligned with WordPress coding style.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

# YAML requires spaces.
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# npm manifests use the standard two-space JSON indentation.
[package*.json]
indent_style = space
indent_size = 2

# Preserve significant trailing whitespace in prose/readme files.
[*.{md,txt}]
trim_trailing_whitespace = false
